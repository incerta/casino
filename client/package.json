{
  "private": true,
  "name": "incerta-casino-client",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "formatter:fix": "prettier --write .",
    "formatter:check": "prettier --check . || (echo 'ERROR: use `bun run formatter:fix`' && exit 1)",
    "ts": "next typegen && tsc --noEmit",
    "check": "bun run ts && bun run formatter:check && bun run lint",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prettier": "^3.9.6",
    "typescript": "^5"
  }
}
